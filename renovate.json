{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Jolt-Design/Renovate-Config",
    "github>Jolt-Design/Renovate-Config:automerge-biome"
  ],
  "packageRules": [
    {
      "description": "Update the Renovate config validator through weekly lock file maintenance rather than a PR for each release",
      "matchPackageNames": ["renovate"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    }
  ]
}
